# =========================
# App
# =========================
APP_ENV=production
APP_TIMEZONE=Asia/Seoul
LOG_LEVEL=INFO

# Docker container paths
BASE_DIR=/app
LOG_DIR=/app/output/logs
DOWNLOAD_DIR=/app/output/downloads

# =========================
# Database
# =========================
DATABASE_URL=sqlite:////app/data/app.db

# =========================
# Scheduler
# =========================
SCHEDULER_ENABLED=true
SCHEDULER_SKIP_WEEKENDS=true
SCHEDULER_SKIP_PUBLIC_HOLIDAYS=true
SCHEDULE_TIME_1=08:30
SCHEDULE_TIME_2=15:30
RETRY_DELAY_MINUTES=10
MAX_RETRY_COUNT=1

# =========================
# Slack
# =========================
SLACK_USE_SOCKET_MODE=true
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=

SLACK_BRIEFING_CHANNEL_ID=
SLACK_COMMAND_CHANNEL_ID=
CALENDAR_WEB_URL=http://192.168.3.60:8080/calendar

# Command example:
# @biz-monitor 공고:KIMST/국제사회IUU 전자모니터링 시스템 추가
SLACK_COMMAND_PREFIX=공고:
SLACK_COMMAND_SUFFIX=추가

SLACK_SEND_RETRY_COUNT=1
SLACK_SITE_SEND_INTERVAL_SECONDS=1.2
SLACK_MAX_NOTICES_PER_SITE=40
SLACK_MAX_NOTICES_G2B=30
SLACK_MAX_ZERO_STAR_PER_SITE=10
SLACK_RESEND_ON_NEXT_RUN_IF_SEND_FAILED=true
SLACK_DEFERRED_PUBLISH_ENABLED=true
SLACK_PUBLISH_TIME_1=09:00
SLACK_PUBLISH_TIME_2=16:00
SLACK_DEFERRED_PUBLISH_SINCE=

# =========================
# Feature Flags
# =========================
ENABLE_MANUAL_COMMANDS=true
ENABLE_RELEVANCE_FILTER=true
ENABLE_DEADLINE_FILTER_D2B=true

# =========================
# AI Relevance
# =========================
# biz-monitor calls this internal gateway only. Codex OAuth stays in OpenClaw cron-google.
AI_RELEVANCE_ENABLED=false
AI_RELEVANCE_GATEWAY_URL=http://host.docker.internal:8091/v1/agent
AI_RELEVANCE_GATEWAY_TOKEN=
AI_RELEVANCE_AGENT=cron-google
AI_RELEVANCE_PROMPT_VERSION=v1
AI_RELEVANCE_TIMEOUT_SECONDS=300
AI_RELEVANCE_MAX_PER_RUN=30
AI_RELEVANCE_SHARE_THRESHOLD=70
AI_RELEVANCE_MIN_RULE_SCORE=1
AI_RELEVANCE_EVALUATE_RULE_FAILED=true
AI_RELEVANCE_PREPARE_MINUTES_BEFORE_PUBLISH=10

# =========================
# Site Enable Flags
# =========================
SITE_G2B_ENABLED=true
SITE_KIMST_ENABLED=true
SITE_NIA_ENABLED=true
SITE_D2B_ENABLED=true
SITE_KMITI_ENABLED=true
SITE_IRIS_ENABLED=true

# =========================
# Initial Search Keywords
# =========================
G2B_KEYWORDS=기상정보,기상자료,기상관측,기상센서,수치예보,수치예보모델,수치예보시스템,장기예보,확률장기예보,항공기상,항공기상예보,스마트항공예보,해양기상,도로기상,상세기상,기상관측부이,기상레이더,기상재해,스마트양식,육상양식,육상양식장,양식장 자동화,아쿠아포닉스,RAS,어선,어업,해양안전,선박,해양환경,해양관측,데이터 로거,영상분석,유지관리,양식,유지보수,통합관리,기상 유지보수,해양기상 유지보수,항공기상 유지보수,스마트항공예보 유지보수,기상 통합관리,해양 통합관리,양식장 통합관리,해양 양식,수산 양식,국립수산과학원,국립해양조사원,해양환경공단,기상청,항공기상청
KIMST_KEYWORDS=해양,수산,양식,스마트양식,육상양식,육상양식장,양식장 자동화,아쿠아포닉스,RAS,어선,어업,원양어선,전자모니터링,해양안전,선박,해양환경,해양관측,해양쓰레기,수산자원,해양기상,AI,인공지능,데이터,빅데이터,공간정보,GIS,모니터링,자동화,플랫폼,테스트베드
NIA_KEYWORDS=AI,인공지능,데이터,빅데이터,데이터 바우처,데이터바우처,데이터바우처지원사업,AI가공,공동활용,공공데이터,데이터 플랫폼,데이터 품질,데이터 구축,데이터 개방,마이데이터,클라우드,디지털서비스,지능정보,정보화전략,ISP,공간정보,GIS,기상데이터,해양데이터,수산데이터,모니터링
D2B_KEYWORDS=기상,기상관측,기상센서,항공기상,해양,수산,양식,어선,선박,해양안전,안전,감시,관측,정찰,AI,인공지능,데이터,영상분석,모니터링,자동화,공간정보,GIS
KMITI_KEYWORDS=기상,기후,기상정보,기상자료,기상관측,기상센서,기상관측자료,수치예보,수치예보모델,수치예보시스템,장기예보,확률장기예보,항공기상,항공기상예보,스마트항공예보,해양기상,도로기상,상세기상,기상관측부이,기상레이더,기상재해,방재기상,폭염,한파,태풍,해무,부이,miniAWS,AI,인공지능,데이터,모니터링,유지관리,유지보수,통합관리,표준화
IRIS_KEYWORDS=기상,기후,기상정보,기상자료,기상관측,수치예보,수치예보모델,항공기상,해양기상,도로기상,기상재해,해양,수산,양식,스마트양식,육상양식,아쿠아포닉스,RAS,어선,어업,해양안전,선박,해양환경,해양관측,AI,인공지능,데이터,빅데이터,공간정보,GIS,영상분석,모니터링,자동화,플랫폼,테스트베드,디지털트윈

# =========================
# Company Relevance
# =========================
COMPANY_GLOBAL_KEYWORDS=
COMPANY_GLOBAL_ORGANIZATIONS=

# Title/body keywords that always exclude a notice from Slack sharing.
EXCLUDED_SCOPE_KEYWORDS=조경,수목,도로포장,도로 포장,폐기물,재난대비,재난 대비,공원,차량,건축,이온,물류반송,반송설비,물류 운반,물류운반,수경시설,수경시설 운영,물놀이형 수경시설,잔디,상수도,하수관로,관망정비,교육생,인턴,채용

# =========================
# D2B Policy
# =========================
D2B_INCLUDE_REBID=true
D2B_INCLUDE_CORRECTION=true
D2B_EXCLUDE_CANCELED=true
D2B_EXCLUDE_DELAYED=true

# =========================
# Runtime
# =========================
RUNNER_POLL_INTERVAL_SECONDS=10
# A running job is requeued only after its worker stops sending heartbeats for
# this long (liveness via heartbeat_at, not just claim time).
JOB_RUNNING_STALE_MINUTES=30
# How often each worker refreshes its running job's heartbeat. Keep well below
# JOB_RUNNING_STALE_MINUTES so a slow-but-alive job is never falsely requeued.
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
PLAYWRIGHT_HEADLESS=true
TEMP_DIR=/app/output/tmp
