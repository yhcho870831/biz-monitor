[Unit]
Description=biz-monitor scheduled collection run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=koast
Group=koast
WorkingDirectory=/home/koast/biz-monitor
EnvironmentFile=/home/koast/biz-monitor/.env
ExecStart=/home/koast/biz-monitor/.venv/bin/python -m app.main run-scheduled-once

